# ==============================================================================
# BLACK GENIAL 2026 - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================
# Este arquivo serve como documentação de variáveis opcionais para produção.
# Para utilizar no Vite, prefixe as variáveis públicas com VITE_
#
# Exemplo de URLs de checkout integradas via gateway (Hotmart / Eduzz / Kiwify / etc.):
# VITE_CHECKOUT_PLANO_ATE_PASSAR=https://pay.exemplo.com/black-ate-passar
# VITE_CHECKOUT_PLANO_ANUAL=https://pay.exemplo.com/black-anual
#
# Exemplo de tags de métricas e analytics (caso injetadas dinamicamente):
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=000000000000000
